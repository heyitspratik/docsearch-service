# Copy to .env:  cp .env.example .env
# Every variable is optional; these are the defaults.

# --- Application ---
APP_NAME="FastAPI Service"
APP_VERSION="0.1.0"
APP_DESCRIPTION="FastAPI microservice"
# local | test | dev | staging | production
APP_ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_RELOAD=true
APP_ROOT_PATH=
APP_API_PREFIX=/api
# Always off in production.
APP_DOCS_ENABLED=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# console | json
APP_LOG_FORMAT=console

# --- Database ---
DB_ENABLED=false
DB_DRIVER=postgresql+asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=false

# For MySQL, use these two instead and run `uv sync --extra mysql`.
#DB_DRIVER=mysql+aiomysql
#DB_PORT=3306

# --- Redis ---
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

# --- Qdrant ---
QDRANT_ENABLED=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=10
QDRANT_COLLECTION_ALIAS=chunks

# --- MongoDB ---
MONGO_ENABLED=false
MONGO_HOST=localhost
MONGO_PORT=27017
# Docker Compose creates this user; leave both empty for a server without auth.
MONGO_USER=app
MONGO_PASSWORD=app
MONGO_DB=docsearch
MONGO_MAX_POOL_SIZE=10
MONGO_TIMEOUT_MS=5000

# --- S3 (SeaweedFS locally) ---
S3_ENABLED=false
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
# Required when S3_ENABLED=true. Docker Compose's SeaweedFS accepts these.
S3_ACCESS_KEY_ID=docsearch
S3_SECRET_ACCESS_KEY=docsearch-secret
S3_BUCKET=docsearch
# Total tries per request, including the first.
S3_MAX_ATTEMPTS=3

# --- Keycloak ---
# Where the API fetches signing keys (inside Docker: http://keycloak:8080).
KEYCLOAK_URL=http://localhost:8080
# The browser-facing address that appears in tokens; empty = KEYCLOAK_URL.
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_REALM=docsearch
KEYCLOAK_AUDIENCE=docsearch-api
KEYCLOAK_JWKS_CACHE_SECONDS=300

# --- Celery (broker = the Redis server above, this database number) ---
CELERY_REDIS_DB=1
CELERY_MAX_RETRIES=5
CELERY_REQUEUE_AFTER_MINUTES=5

# --- Embeddings ---
EMBEDDING_DENSE_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
EMBEDDING_BM25_LANGUAGE=english
EMBEDDING_BATCH_SIZE=32
# Where downloaded models are kept; empty uses fastembed's temp-dir default.
EMBEDDING_CACHE_DIR=

# --- Reranker ---
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATES=20
RERANKER_TOP_K=5

# --- LLM ---
# A model is hidden from /models until its key is set. Ollama needs none.
LLM_ANTHROPIC_API_KEY=
LLM_OPENAI_API_KEY=
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=2048
LLM_CONTEXT_TOKEN_BUDGET=6000
LLM_HISTORY_MESSAGES=6

# --- Upload ---
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_MAX_FILES=10
UPLOAD_OCR_LANGUAGE=en

# --- Cache ---
CACHE_ENABLED=true
# 7 days
CACHE_QUERY_VECTOR_TTL_SECONDS=604800
CACHE_SEARCH_RESULT_TTL_SECONDS=3600

# --- OpenTelemetry ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=docsearch-api
# Empty prints spans to the console instead of exporting them.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Langfuse (on when both keys are set) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Docker Compose only ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
# Published ports for Redis, Qdrant and MongoDB come from REDIS_PORT,
# QDRANT_PORT and MONGO_PORT above. Change one if something else on this
# machine already uses that port.
SEAWEEDFS_PORT=8333
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:8b
