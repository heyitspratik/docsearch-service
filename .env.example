# Copy to .env:  cp .env.example .env
# Every variable is optional; these are the defaults.

# --- Application ---
APP_NAME="FastAPI Service"
APP_VERSION="0.1.0"
APP_DESCRIPTION="FastAPI microservice"
# local | test | dev | staging | production
APP_ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_RELOAD=true
APP_ROOT_PATH=
APP_API_PREFIX=/api
# Always off in production.
APP_DOCS_ENABLED=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# console | json
APP_LOG_FORMAT=console

# --- Database ---
DB_ENABLED=false
DB_DRIVER=postgresql+asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=false

# For MySQL, use these two instead and run `uv sync --extra mysql`.
#DB_DRIVER=mysql+aiomysql
#DB_PORT=3306

# --- Redis ---
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

# --- Docker Compose only ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
